# --- Rust specific ---
# The target directory where all build artifacts are stored
/target/

# Backup files generated by rustfmt
**/*.rs.bk

# Mutation testing data generated by cargo-mutants
**/mutants.out*/

# MSVC Windows builds generate these for debugging
*.pdb

# --- IDEs and Editors ---
# JetBrains (IntelliJ, RustRover, CLion)
.idea/
*.iml

# VS Code
.vscode/
# Unless you want to share specific workspace settings

# --- OS Specific ---
.DS_Store
Thumbs.db

# --- Project Specific ---
# Log files generated by the network mapper
*.log

# Generated reports (JSON, CSV, HTML)
reports/
*.report.json
*.report.csv
*.report.html

# Saved topology visualizations
topology_positions.json

# Temporary scan data
scan_cache/

# Credentials (if stored locally - should use config instead)
credentials.toml
secrets.toml
